# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
ENV/
.venv/

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# User-excluded document formats
*.pdf
*.pptx
*.txt

# Datasets (raw telemetry files excluded from git)
archive/
*.csv
data/

# Model binaries (>100MB exceeds GitHub hard push limit)
*.joblib
*.pkl
*.h5
results/models/*.joblib
!results/models/.gitkeep
Random_Forest/results/models/*.joblib
!Random_Forest/results/models/.gitkeep
Decision_Tree/results/models/*.joblib
!Decision_Tree/results/models/.gitkeep
KNN/results/models/*.joblib
!KNN/results/models/.gitkeep
RF_New/results/models/*.joblib
!RF_New/results/models/.gitkeep
RF_Temporal/results/models/*.joblib
!RF_Temporal/results/models/.gitkeep

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
